# Google Gemini API key. Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: which Gemini model to use. Defaults to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash

# Optional: max output tokens for LLM responses (raise if your JSON is big)
GEMINI_MAX_OUTPUT_TOKENS=8192
