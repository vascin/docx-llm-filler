# ==============================================================
# API keys are NOT configured on the server — the user supplies
# their own key via the web form. The settings below only hold
# model identifiers and output-token caps so they can be tuned
# per deployment without touching the code.
# ==============================================================

# --- Google Gemini ---
# gemini-2.5-flash-lite is the fastest free-tier model.
# gemini-2.0-flash is geo-restricted (RU/BY get quota=0).
GEMINI_MODEL=gemini-2.5-flash-lite
# Max output tokens. 65536 handles ~80-page docs.
GEMINI_MAX_OUTPUT_TOKENS=65536

# --- GigaChat (Sber) ---
GIGACHAT_MODEL=GigaChat
GIGACHAT_MAX_OUTPUT_TOKENS=8000
# GigaChat uses Russian Trusted Root CA. Set to false only if your
# system CA bundle doesn't include it and you cannot install it.
GIGACHAT_VERIFY_SSL=true

# --- YandexGPT ---
# yandexgpt-lite/latest (cheaper) or yandexgpt/latest (higher quality).
YANDEX_MODEL=yandexgpt-lite/latest
YANDEX_MAX_OUTPUT_TOKENS=8000
