# Google Gemini API key. Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: which Gemini model to use. Defaults to gemini-2.5-flash-lite.
# Note: gemini-2.0-flash free tier is geo-restricted (RU/BY/etc. get quota=0).
# gemini-2.5-flash-lite is the fastest + most reliable for free tier; use
# gemini-2.5-flash if you want higher quality (subject to occasional 503s).
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: max output tokens for LLM responses.
# 65536 is the max for gemini-2.5-flash / flash-lite and handles ~80-page docs.
# Lower this only if you want to cap per-request cost on the paid tier.
GEMINI_MAX_OUTPUT_TOKENS=65536
